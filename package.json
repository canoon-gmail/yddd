{
  "name": "yddd",
  "productName": "YDDD",
  "version": "0.1.0",
  "description": "YDDD - a direct NURBS/B-rep CAD modeler for Linux (Electron + Three.js + OpenCascade)",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "start:stress": "npm run build && YDDD_STRESS=${N:-2000} electron .",
    "dev": "npm run build:main && node scripts/dev.mjs",
    "smoke": "npm run build && YDDD_SMOKE=/tmp/yddd-smoke electron .",
    "smoke:half": "npm run build && YDDD_SMOKE=/tmp/yddd-smoke YDDD_SMOKE_HALF=1 electron .",
    "bench": "npm run build && YDDD_STRESS=${N:-2000} YDDD_BENCH=1 electron .",
    "bench:ops": "npm run build && YDDD_BENCH=ops electron ."
  },
  "dependencies": {
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "electron": "^44.7.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
